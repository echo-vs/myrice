// hyprEcho · Waybar
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 6,

  "modules-left":   ["custom/logo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["mpris", "pulseaudio", "network", "cpu", "memory", "hyprland/language", "tray", "custom/dnd", "custom/power"],

  "custom/logo": {
    "format": "茶",
    "tooltip-format": "ЛКМ: лаунчер · ПКМ: настройки",
    "on-click": "rofi -show drun",
    "on-click-right": "~/.config/hypr/rice/gui.py"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B · %H:%M}",
    "locale": "en_US.UTF-8",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#f7a8d8'><b>{}</b></span>",
        "weekdays": "<span color='#a68aa8'>{}</span>",
        "today":    "<span color='#2b1f2e' background='#f7a8d8'><b> {} </b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_down", "on-scroll-down": "shift_up" }
  },

  "mpris": {
    "format": "{status_icon}  {artist} — {title}",
    "format-paused": "{status_icon}  <i>{title}</i>",
    "status-icons": { "playing": "󰏤", "paused": "󰐊", "stopped": "󰓛" },
    "max-length": 40,
    "ignored-players": ["firefox"]
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  —",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pwvucontrol || pavucontrol"
  },

  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} · {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "interval": 3
  },

  "cpu": {
    "format": "󰍛  {usage}%",
    "interval": 3,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰘚  {percentage}%",
    "tooltip-format": "{used:0.1f} / {total:0.1f} ГБ",
    "interval": 5,
    "states": { "warning": 75, "critical": 90 }
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "on-click": "hyprctl switchxkblayout all next",
    "on-click-right": "~/.config/hypr/rice/gui.py lang"
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/dnd": {
    "exec": "~/.config/hypr/scripts/dnd.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/hypr/scripts/dnd.sh toggle"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Питание",
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  }
}
